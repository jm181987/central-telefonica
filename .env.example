PBX_DOMAIN=pbx.example.com

# External PostgreSQL. Do not commit real credentials.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME

REDIS_URL=redis://redis:6379

JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN

ARI_URL=http://asterisk:8088
ARI_USERNAME=pbxapi
ARI_PASSWORD=CHANGE_ME_ARI
ARI_APP=central-telefonica

AMI_HOST=asterisk
AMI_PORT=5038
AMI_USERNAME=pbxami
AMI_PASSWORD=CHANGE_ME_AMI

# VONO: obtain LOGIN, SENHA and DOMÍNIO/SERVIDOR from Meu Vono.
VONO_HOST=CHANGE_ME_VONO_DOMAIN
VONO_PORT=5060
VONO_TRANSPORT=udp
VONO_USERNAME=CHANGE_ME_VONO_LOGIN
VONO_AUTH_USERNAME=CHANGE_ME_VONO_LOGIN
VONO_PASSWORD=CHANGE_ME_VONO_PASSWORD
VONO_FROM_USER=CHANGE_ME_VONO_LOGIN
VONO_FROM_DOMAIN=CHANGE_ME_VONO_DOMAIN
VONO_REGISTRATION=true
VONO_CODECS=alaw,g722,ulaw
VONO_DTMF_MODE=rfc4733
VONO_MEDIA_ENCRYPTION=none
VONO_MAX_CHANNELS=5

RTP_START=10000
RTP_END=20000
RECORD_CALLS=false

# Vercel frontend -> external PBX/API
VITE_API_BASE_URL=https://pbx.example.com
VITE_SOCKET_URL=https://pbx.example.com
VITE_SIP_WS_URL=wss://pbx.example.com/ws
VITE_SIP_DOMAIN=pbx.example.com
