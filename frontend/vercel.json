{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --prefer-offline --no-audit --no-fund",
  "rewrites": [
    { "source": "/((?!api/|socket.io/|ws$).*)", "destination": "/index.html" }
  ]
}
